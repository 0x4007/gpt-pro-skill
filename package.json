{
  "name": "gpt-pro-skill",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only lint tooling for the gpt-pro Deno skill. Single source of truth for tool versions; consumed by both npx and deno.json tasks.",
  "scripts": {
    "format": "sh scripts/format.sh",
    "format:check": "sh scripts/format.sh --check",
    "knip": "sh scripts/knip.sh",
    "lint": "sh scripts/lint.sh",
    "lint:fix": "sh scripts/lint.sh --fix",
    "verify": "sh scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/node": "^24.0.0",
    "eslint": "9.14.0",
    "eslint-plugin-check-file": "^2.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "knip": "^5.62.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.0"
  }
}
